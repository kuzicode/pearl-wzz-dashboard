{
  "image": "docker.io/kuzigmgm/pearl-miner:srb-3.6.9-r3",
  "max_active_instances": 1,
  "max_total_hourly_usd": 1.0,
  "poll_seconds": 10,
  "prl_address": "prl1REPLACE_WITH_YOUR_OWN_WALLET_ADDRESS",
  "prl_host": "stratum+ssl://prl.kryptex.network:8048",
  "pool": "kryptex",
  "miner": "srbminer",
  "monitor_pools": [
    "kryptex"
  ],
  "provider_intervals_seconds": {
    "vast": 2,
    "runpod": 10,
    "tensordock": 10
  },
  "worker_prefix": "auto",
  "alert_url": "",
  "vast": {
    "enabled": false,
    "allow_other_countries": true,
    "block_countries": [],
    "creating_timeout_seconds": 600,
    "disk_gb": 20,
    "max_offer_price_usd": 0.6,
    "min_offer_price_usd": 0.03,
    "min_cpu_cores_effective": 1,
    "min_cpu_ram_mb": 4000,
    "min_disk_gb": 15,
    "min_gpu_frac": 1.0,
    "max_instances_per_machine": 2,
    "min_reliability": 0.95,
    "prefer_countries": [
      "US",
      "CA"
    ],
    "thresholds": {
      "RTX 4090": 0.3,
      "NVIDIA GeForce RTX 4090": 0.3,
      "RTX 5090": 0.42,
      "NVIDIA GeForce RTX 5090": 0.42
    },
    "hashrate_watch_enabled": true,
    "hashrate_watch_interval_seconds": 30,
    "hashrate_log_tail_lines": 300,
    "hashrate_grace_seconds": 600,
    "low_efficiency_stop_seconds": 900,
    "min_th_per_usd_hour": 334,
    "min_hashrate_th": {
      "RTX 4090": 250,
      "NVIDIA GeForce RTX 4090": 250,
      "RTX 5090": 300,
      "NVIDIA GeForce RTX 5090": 300
    },
    "missing_worker_as_zero": true,
    "create_enabled": false
  },
  "runpod": {
    "enabled": false,
    "create_enabled": false
  },
  "tensordock": {
    "enabled": false,
    "create_enabled": false
  }
}
