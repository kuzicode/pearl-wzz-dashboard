{
  "image": "docker.io/kuzigmgm/pearl-miner:v13-wildrig",
  "max_active_instances": 1,
  "max_total_hourly_usd": 1.0,
  "poll_seconds": 10,
  "prl_address": "prl1REPLACE_WITH_YOUR_OWN_WALLET_ADDRESS",
  "prl_host": "pool.pearlhash.xyz:9000",
  "pool": "pearlhash",
  "monitor_pools": [
    "pearlhash"
  ],
  "provider_intervals_seconds": {
    "vast": 2,
    "runpod": 10,
    "tensordock": 10
  },
  "worker_prefix": "auto",
  "alert_url": "",
  "vast": {
    "enabled": false,
    "allow_other_countries": true,
    "creating_timeout_seconds": 600,
    "disk_gb": 20,
    "max_offer_price_usd": 0.9,
    "min_offer_price_usd": 0.05,
    "min_cpu_cores_effective": 1,
    "min_cpu_ram_mb": 4000,
    "min_disk_gb": 15,
    "min_gpu_frac": 1.0,
    "min_reliability": 0.9,
    "prefer_countries": [
      "US",
      "CA"
    ],
    "thresholds": {
      "RTX 4090": 0.4,
      "RTX 5090": 0.5,
      "NVIDIA GeForce RTX 4090": 0.4,
      "NVIDIA GeForce RTX 5090": 0.5
    },
    "hashrate_watch_enabled": true,
    "hashrate_watch_interval_seconds": 30,
    "hashrate_log_tail_lines": 300,
    "hashrate_grace_seconds": 600,
    "low_efficiency_stop_seconds": 300,
    "min_th_per_usd_hour": 334,
    "min_hashrate_th": {
      "RTX 5090": 250,
      "RTX 4090": 220,
      "NVIDIA GeForce RTX 4090": 220,
      "NVIDIA GeForce RTX 5090": 250
    },
    "missing_worker_as_zero": true,
    "create_enabled": false
  },
  "runpod": {
    "enabled": false,
    "create_enabled": false
  },
  "tensordock": {
    "enabled": false,
    "create_enabled": false
  }
}
