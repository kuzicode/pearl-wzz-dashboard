{
  "image": "docker.io/kuzigmgm/pearl-miner:v13-wildrig",
  "max_active_instances": 1,
  "max_total_hourly_usd": 1.0,
  "poll_seconds": 10,
  "prl_address": "prl1REPLACE_WITH_YOUR_OWN_WALLET_ADDRESS",
  "prl_host": "pool.pearlhash.xyz:9000",
  "pool": "pearlhash",
  "monitor_pools": [
    "pearlhash"
  ],
  "provider_intervals_seconds": {
    "vast": 10,
    "runpod": 2,
    "tensordock": 10
  },
  "worker_prefix": "auto",
  "alert_url": "",
  "vast": {
    "enabled": false
  },
  "runpod": {
    "enabled": false,
    "create_enabled": false,
    "observe_enabled": true,
    "cloud_type": "COMMUNITY",
    "cloud_types": [
      "COMMUNITY"
    ],
    "country_codes": [],
    "unrestricted_country_gpu_keywords": [
      "4090",
      "5090"
    ],
    "container_disk_gb": 10,
    "volume_gb": 1,
    "min_download_mbps": 50,
    "min_upload_mbps": 20,
    "min_ram_per_gpu": 8,
    "min_vcpu_per_gpu": 2,
    "create_retry_seconds": 20,
    "observe_no_hit_log_interval_seconds": 300,
    "observe_error_log_interval_seconds": 300,
    "thresholds": {
      "RTX 4090": 0.34,
      "NVIDIA GeForce RTX 4090": 0.34,
      "RTX 5090": 0.45,
      "NVIDIA GeForce RTX 5090": 0.45
    },
    "hashrate_watch_interval_seconds": 30,
    "hashrate_zero_recover_seconds": 120,
    "hashrate_grace_seconds": 600,
    "low_efficiency_stop_seconds": 900,
    "backdate_low_efficiency_for_existing": true,
    "min_th_per_usd_hour": 334,
    "min_hashrate_th": {
      "RTX 4090": 250,
      "NVIDIA GeForce RTX 4090": 250,
      "RTX 5090": 300,
      "NVIDIA GeForce RTX 5090": 300
    },
    "create_observed_price_factor": 1.0,
    "short_exit_blacklist_seconds": 60,
    "cleanup_untracked_terminal_pods": false,
    "hashrate_watch_enabled": true
  },
  "tensordock": {
    "enabled": false,
    "create_enabled": false
  }
}
