# 平台 API key: 只填你要用的平台, 其余留空(留空的账号 start-all 会自动跳过, 不会去请求平台)
VAST_API_KEY=
RUNPOD_API_KEY=
TENSORDOCK_API_TOKEN=
# 可选: 仅启用 Salad(config.salad.json 的 salad.enabled=true)时需要
SALAD_API_KEY=
# 可选: 仅启用 QuickPod 时需要(console → Settings → API keys, 勾 Pods read + Pods write + Templates read + Profile read 即可)
QUICKPOD_API_KEY=

# 网页看板登录(默认密码 123456, 务必改掉)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=123456
DASHBOARD_PORT=8787
# 访客「偷窥模式」(无密码只读看仪表盘): 1 开 / 0 关(关闭后登录页无入口, 已登录访客立即失效; 配置页也可切换)
DASHBOARD_GUEST_ENABLED=1
# 看板监听地址。默认只监听本机 127.0.0.1(本机浏览器 http://localhost:8787 可开; 云服务器需前置 Caddy/Nginx 反代给 HTTPS)。
# 云服务器想直接用 http://<服务器IP>:8787 访问, 改成 0.0.0.0(明文暴露公网, 务必改强密码)。
DASHBOARD_HOST=127.0.0.1
